{
  "name": "dino-with-friends",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "send_metrics": false,
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/ws/*"] },
  "durable_objects": { "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }]
}
